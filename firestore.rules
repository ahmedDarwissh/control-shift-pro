rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow logged-in users to read and write their own data in the 'users' collection
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Example: Allow logged-in users to read/write their own daily tasks
    match /users/{userId}/dailyTasks/{taskId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Example: Allow logged-in users to read/write their own leave requests
    match /leaveRequests/{leaveRequestId} {
      // Allow create if user is logged in and userId matches auth.uid
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow read/update/delete if user is logged in and owns the document
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    // Healthcheck document - allow read for all (useful for reachability checks)
    match /__ctrlshiftpro_healthcheck__/{docId} {
      allow read: if true;
    }
    // Add other rules for other collections as needed.
    // By default, access to other collections will be denied.
  }
}